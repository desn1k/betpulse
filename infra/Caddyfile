# Caddy reverse proxy with automatic TLS. PUBLIC_DOMAIN must be the production
# hostname. The Next.js frontend is the public entrypoint: its /api/* route
# handlers are the BFF that talks to the FastAPI service over the internal
# network (FastAPI routes carry no /api prefix). The only FastAPI path exposed
# publicly is the Telegram bot webhook. Interactive API docs are not published.
#
# Client IP: no `trusted_proxies` is configured, so Caddy discards any incoming
# X-Forwarded-For and sends upstream only the connecting client's address. The
# BFF and the API rely on that (see SECURITY.md). If a CDN/WAF is ever placed in
# front of Caddy, configure `trusted_proxies` for it and re-review the chain.
# The connecting address is the client's only because the Compose network is
# dual-stack (F5, infra/docker-compose.yml): on an IPv4-only network Docker's
# userland proxy relays IPv6 clients, and Caddy sees them all as the gateway.
# scripts/edge-identity-smoke.sh (CI) checks both families.
#
# Routing and the X-Forwarded-For replacement are covered by
# scripts/caddy-smoke.sh (run in CI).

# Closed-trial certificates (docs/DEPLOY_VPS.md, path A): with 80/443 open only
# to the operator, ACME cannot reach the server. CADDY_TRIAL_TLS=local_certs
# makes Caddy issue the certificate for PUBLIC_DOMAIN from its own CA instead;
# empty (the default) keeps public ACME certificates. check-compose-ports.sh
# accepts only those two values and reports which one is in effect.
{
	{$CADDY_TRIAL_TLS}
}

{$PUBLIC_DOMAIN:localhost} {
	encode zstd gzip

	# Security headers (a fuller CSP is added in the Phase 13 hardening pass).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-XSS-Protection "0"
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	# Telegram calls this directly; it authenticates via the
	# X-Telegram-Bot-Api-Secret-Token header. Exact path only — every other
	# /push/* path belongs to the frontend.
	handle /push/telegram/webhook {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}

# Container healthcheck (docker-compose.prod.yml), on its own plain-HTTP port,
# never published. It cannot use the site above: once PUBLIC_DOMAIN is a real
# domain, http://localhost/healthz is redirected to HTTPS, and there is no
# certificate for localhost, so the check (and every deploy) would fail.
http://:8081 {
	respond /healthz "ok" 200
}
