# Caddy reverse proxy with automatic TLS. PUBLIC_DOMAIN must be the production
# hostname. The Next.js frontend is the public entrypoint: its /api/* route
# handlers are the BFF that talks to the FastAPI service over the internal
# network (FastAPI routes carry no /api prefix). The only FastAPI path exposed
# publicly is the Telegram bot webhook. Interactive API docs are not published.
#
# Routing is covered by scripts/caddy-smoke.sh (run in CI).

{$PUBLIC_DOMAIN:localhost} {
	encode zstd gzip

	# Security headers (a fuller CSP is added in the Phase 13 hardening pass).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-XSS-Protection "0"
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	# Telegram calls this directly; it authenticates via the
	# X-Telegram-Bot-Api-Secret-Token header. Exact path only — every other
	# /push/* path belongs to the frontend.
	handle /push/telegram/webhook {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
