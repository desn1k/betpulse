# Keep comments on their own lines: Docker Compose reads `KEY=  # note` as the
# value `# note` (production refuses such placeholder secrets).
# =============================================================================
#  Football Analytics Platform — environment template
#  Copy to .env and fill in. NEVER commit .env. Rotate every secret before prod.
#  Generate secrets with:  openssl rand -hex 32
# =============================================================================

# --- Core -------------------------------------------------------------------
# development | staging | production
ENVIRONMENT=development
DEBUG=false
APP_NAME=football-analytics
PUBLIC_BASE_URL=http://localhost:3000
# Local dev only (the Next.js dev server calling the API published on the host).
# Production ignores it: infra/docker-compose.prod.yml sets the web container's
# API_BASE_URL to http://api:8000 (the internal network).
API_BASE_URL=http://localhost:8000
# ru | en
DEFAULT_LOCALE=ru
TZ=Europe/Moscow

# --- Release and production deployment --------------------------------------
# Set GHCR_OWNER to the GitHub account/organization that owns the images.
# Deploy and rollback require an immutable IMAGE_TAG (for example v1.2.3), not `latest`.
GHCR_OWNER=desn1k
IMAGE_TAG=
# DNS name served by Caddy, for example app.example.com. Required by the
# production Compose config (passed to the caddy container); Caddy requests the
# TLS certificate for exactly this name.
PUBLIC_DOMAIN=
DEPLOY_HEALTHCHECK_ATTEMPTS=30

# --- Security ---------------------------------------------------------------
# openssl rand -hex 32 — signs JWT access tokens
SECRET_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Master key used to envelope-encrypt provider/LLM/TOTP secrets at rest. Losing it
# means losing every stored secret. Back it up separately from the DB.
# openssl rand -hex 32
DATA_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_2FA_REQUIRED=true

# Argon2id password hashing (see backend/app/core/security.py for the rationale)
ARGON2_TIME_COST=3
# 64 MiB
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# Auth cookies (refresh token is httpOnly+SameSite=Strict; CSRF is double-submit).
# Keep AUTH_COOKIE_SECURE=true in prod; set false only for local http dev.
AUTH_COOKIE_SECURE=true
# A refresh token re-presented within this window of its rotation (double-click,
# two tabs) gets 409 instead of revoking the session family as a replay.
REFRESH_REUSE_GRACE_SECONDS=10
# A rotated refresh token re-presented within this window, from the same
# user-agent and client subnet while its successor is unused, gets that same
# successor back instead (a lost answer is not a logout). 0 turns it off;
# otherwise between REFRESH_REUSE_GRACE_SECONDS and 300.
REFRESH_REPLAY_WINDOW_SECONDS=60
# successful replays of one rotated token
REFRESH_REPLAY_MAX_USES=3
# feature flag for the require_verified gate
EMAIL_VERIFICATION_REQUIRED=false

# Login abuse controls: per-IP rate limit + per-account exponential backoff lockout
# per client IP
RATE_LIMIT_LOGIN_PER_MINUTE=5
# per account before backoff starts
LOGIN_MAX_FAILURES=5
# doubles each further failure...
LOCKOUT_BASE_SECONDS=30
# ...capped here (never a permanent lock)
LOCKOUT_MAX_SECONDS=3600
RATE_LIMIT_PROMO_PER_HOUR=10
# per user / guest IP
RATE_LIMIT_LLM_ANALYSIS_PER_MINUTE=20
# per client IP for unsafe /admin methods
RATE_LIMIT_ADMIN_MUTATION_PER_MINUTE=60
# successful refresh-token replays per client IP; over it the ordinary rules apply
RATE_LIMIT_REFRESH_REPLAY_PER_MINUTE=10
# GET /matches/{id} per user / guest IP, before the lookup (a match page refetches once a minute)
RATE_LIMIT_MATCH_DETAIL_PER_WINDOW=120
RATE_LIMIT_MATCH_DETAIL_WINDOW_SECONDS=60
# GET /matches (the list) per user / guest IP, before tier resolution (one page view
# is 1 request, each new filter 1, the poll 1 a minute per tab; headroom for shared NAT)
RATE_LIMIT_MATCH_LIST_PER_WINDOW=120
RATE_LIMIT_MATCH_LIST_WINDOW_SECONDS=60
# POST /auth/refresh per client IP, before the rotation; fails open when Redis is down
RATE_LIMIT_REFRESH_PER_MINUTE=120
# Per-IP limits and guest quotas bucket IPv6 clients by /64; audit logs keep the full address.

# --- Reverse proxies and client IP -------------------------------------------
# The API honours X-Forwarded-For only from these comma-separated CIDRs (the
# Next.js BFF and Caddy) and otherwise uses the TCP peer. Required in production;
# 0.0.0.0/0, public ranges and prefixes broader than /16 (IPv6: /48) are rejected.
# Docker Compose sets it from the pinned addresses below, so leave it unset there.
# Unset outside production it defaults to loopback (local uvicorn + next dev).
# TRUSTED_PROXY_CIDRS=172.29.89.10/32,172.29.89.11/32,fd42:b7e1:5a29:89::10/128,fd42:b7e1:5a29:89::11/128
# Our own Docker network's subnets: a client identity inside them is the bridge
# gateway, never a client; the API logs it once and shows it on the admin system
# health page (F5). Required in production; Docker Compose sets it from the
# subnets below, so leave it unset there.
# INTERNAL_NETWORK_CIDRS=172.29.89.0/24,fd42:b7e1:5a29:89::/64
# Pinned dual-stack Compose network and proxy addresses. Change them together if
# a subnet collides with another network on the host; scripts/check-compose-ports.sh
# checks that they agree. Changing them on an existing stack needs a one-time
# `scripts/prod-compose.sh down` (no -v) before the next deploy.
BETPULSE_NETWORK_SUBNET=172.29.89.0/24
BETPULSE_NETWORK_GATEWAY=172.29.89.1
BETPULSE_WEB_IP=172.29.89.10
BETPULSE_CADDY_IP=172.29.89.11
BETPULSE_NETWORK_SUBNET6=fd42:b7e1:5a29:89::/64
BETPULSE_NETWORK_GATEWAY6=fd42:b7e1:5a29:89::1
BETPULSE_WEB_IP6=fd42:b7e1:5a29:89::10
BETPULSE_CADDY_IP6=fd42:b7e1:5a29:89::11

# --- Bootstrap admin (created by `make seed`; empty password → one-time printed) -
# `make seed` runs `python -m app.bootstrap create-admin`. The admin is created
# with must_change_password=true; admin routes stay locked until it is changed.
ADMIN_EMAIL=admin@example.com
# Required in production: an explicit strong password (12+ characters).
# create-admin refuses an empty, placeholder or example value there.
# Development only: leaving it empty generates a one-time password.
ADMIN_PASSWORD=

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=football
POSTGRES_USER=football
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://football:${POSTGRES_PASSWORD}@postgres:5432/football
# Optional read replica (leave empty on a single server)
DATABASE_READ_URL=
# Per-process pools. Security-state writes (lockout, token revocation) use their
# own small pool so a request can never wait on its own pool. Keep the sum over
# all processes under Postgres max_connections (HANDOFF "Database connection budget").
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_SECURITY_POOL_SIZE=2
DB_SECURITY_MAX_OVERFLOW=3

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=


# --- MLflow -----------------------------------------------------------------
# Model artifacts live on the `mlflow_artifacts` volume and travel over this
# server's HTTP API (--serve-artifacts): no object-storage settings needed.
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Football data providers -------------------------------------------------
# Keys are normally added through the ADMIN UI (encrypted at rest).
# These are only a bootstrap fallback for local dev / CI.
# football-data.co.uk needs no key (free CSV, historical + closing odds).
FOOTBALL_DATA_COUK_ENABLED=true
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_DAILY_LIMIT=7500
API_FOOTBALL_PER_MINUTE_LIMIT=300
# Paid providers (HANDOFF §9l). Read today only by `python -m app.cli provider-record`
# (dev tool that records real responses as test fixtures). Never commit real values.
SPORTMONKS_API_TOKEN=
THE_ODDS_API_KEY=

# --- Ingestion & live --------------------------------------------------------
# /fixtures?live=all cadence (self-rescheduling)
LIVE_POLL_INTERVAL_SECONDS=60
# In-play recompute is triggered after each successful poll (event-driven), not a
# fixed timer; recompute runs only when a match's score/minute actually changed.
# 10 percentage points → push
PROBABILITY_SWING_PUSH_THRESHOLD=0.10
# SSE Last-Event-ID reconnect replay bound (5 min)
LIVE_REPLAY_WINDOW_SECONDS=300
ENABLED_LEAGUES=EPL,LALIGA,SERIEA,BUNDESLIGA,LIGUE1,UCL,UEL,UECL,RPL

# --- Model governance --------------------------------------------------------
# rolling out-of-sample window
ACCURACY_WINDOW_DAYS=90
# auto (∝ accuracy) | manual (admin sliders)
CONSENSUS_WEIGHT_MODE=auto
# below this a method cannot become champion
CHAMPION_MIN_SAMPLES=300
# admin registry actions wait this long for the lock, then 409
REGISTRY_LOCK_TIMEOUT_MS=5000
# Reference bookmaker for closing odds by kickoff date (contiguous ranges, open at both ends).
REFERENCE_BOOKMAKERS=[{"bookmaker":"pinnacle","until_date":"2025-07-23"},{"bookmaker":"market_avg","from_date":"2025-07-23"}]
# A historical-ingestion run still "running" after this many minutes is treated as dead.
INGESTION_STALE_RUN_MINUTES=60
# Brier gain (same fixtures) needed to replace the champion
CHAMPION_MIN_BRIER_IMPROVEMENT=0.002
# champions are kept forever regardless
MODEL_RETENTION_VERSIONS=10
# nightly retrain + re-evaluation
RETRAIN_CRON=0 4 * * *

# --- LLM (any OpenAI-compatible endpoint) ------------------------------------
# Configurable from the admin UI too; these are defaults.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1200
# hard stop when exceeded
LLM_DAILY_TOKEN_BUDGET=200000
LLM_CACHE_TTL_SECONDS=21600

# --- Push notifications ------------------------------------------------------
# Swing pushes go to Telegram (Bot HTTP API) and Web Push (VAPID). Delivery is
# rate-limited per fixture and retried exactly once before being discarded.
TELEGRAM_BOT_TOKEN=
# ops alerts: backup/CI/ingest failures
TELEGRAM_ALERT_CHAT_ID=
# base64url EC P-256 public key
WEBPUSH_VAPID_PUBLIC_KEY=
# base64url 32-byte P-256 private scalar
WEBPUSH_VAPID_PRIVATE_KEY=
# becomes the VAPID mailto: subject
WEBPUSH_CONTACT_EMAIL=admin@example.com
# at most one push per (user, fixture) per window
PUSH_RATE_LIMIT_SECONDS=300
# delay before the single retry
PUSH_RETRY_DELAY_SECONDS=30

# --- Email (verification, password reset) ------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# --- Backups -----------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
# age recipient key; private key stored OFFLINE
BACKUP_ENCRYPTION_PUBLIC_KEY=
# weekly restore verification
RESTORE_DRILL_CRON=0 5 * * 0
# alert if newest good backup is older than this
RPO_ALERT_MINUTES=15

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
# /metrics (Prometheus), protected
METRICS_ENABLED=true

# --- Legal / compliance ------------------------------------------------------
# 18+ gate on first visit
AGE_GATE_ENABLED=true
AGE_GATE_CONSENT_DAYS=180
# footer + every prediction card + backtester
DISCLAIMER_REQUIRED=true
