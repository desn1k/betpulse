{
  "comment": "Sportmonks stage 1 (discovery). No credits: limits are per entity per hour (rate_limit block). Stage 2 (seasons, fixtures per league, includes, xG, lineups, livescores) is written from these answers.",
  "calls": [
    {
      "name": "leagues_p1",
      "path": "/v3/football/leagues",
      "params": {
        "include": "country;currentSeason",
        "per_page": 50,
        "page": 1
      }
    },
    {
      "name": "states",
      "path": "/v3/football/states",
      "params": {
        "per_page": 50
      }
    },
    {
      "name": "error_invalid_token",
      "path": "/v3/football/leagues",
      "params": {
        "per_page": 1
      },
      "auth": "invalid",
      "expect": [
        401
      ]
    }
  ]
}
